# Copy to deploy/.env and fill in. Never commit deploy/.env.
# Use URL-safe values for passwords (they go into connection strings), e.g.:
#   openssl rand -hex 24

APP_ENV=production
LOG_LEVEL=info

# Public hostname served by Caddy. "localhost" uses Caddy's local CA.
DOMAIN=localhost

# Schema owner: runs migrations and pcctl. Bypasses row-level security.
OWNER_DB_PASSWORD=
# Service login role (member of pharmachat_app, subject to row-level security).
# Only read when the database volume is first created.
APP_DB_PASSWORD=

# AES-256-GCM key for secrets stored in the database, base64 of 32 random bytes:
#   openssl rand -base64 32
# Losing or changing it makes stored API keys and Meta tokens unreadable.
ENCRYPTION_KEY=

# Read only by `pcctl seed` to create the default AI configuration (encrypted at rest).
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
